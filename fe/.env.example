# Base URL for the OPhim API proxy
# Default: /api/ophim (proxied by Vite dev server to localhost:8080)
# Set this if your backend runs on a different host/port
VITE_API_BASE_URL=/api/ophim
VITE_ENABLE_DIRECT_API_FALLBACK=false
VITE_DIRECT_API_BASE_URL=
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Build-time prerender source. Use backend proxy or direct OPhim API.
PRERENDER_API_BASE_URL=https://ophim1.com/v1/api
PRERENDER_CONCURRENCY=6
PRERENDER_FETCH_PEOPLE=false
