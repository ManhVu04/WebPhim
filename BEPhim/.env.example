MONGODB_URI=mongodb://localhost:27017/webphim?replicaSet=rs0
OPHIM_BASE_URL=https://ophim1.com/v1/api/
OPHIM_CONNECT_TIMEOUT=2s
OPHIM_READ_TIMEOUT=8s
APP_AUTH_ISSUER=http://localhost:8080
APP_AUTH_SPA_REDIRECT_URI=http://localhost:5173/callback
APP_AUTH_SPA_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
APP_SECURITY_CSP_ALLOWED_FRAME_HOSTS=
APP_PUBLIC_URL=http://localhost:5173
APP_AUTH_REFRESH_COOKIE_SECURE=false
APP_AUTH_REFRESH_COOKIE_SAME_SITE=Lax
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_RATE_LIMIT_LOGIN=10
APP_RATE_LIMIT_REGISTER=5
APP_RATE_LIMIT_FORGOT_PASSWORD=5
APP_RATE_LIMIT_RESEND_VERIFICATION=3
APP_RATE_LIMIT_REFRESH=60
APP_RATE_LIMIT_PROXY=120
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_SECURE=false
MAIL_FROM=your-email@gmail.com
# Generate with: openssl rand -base64 32
APP_MAIL_OUTBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
APP_MAIL_OUTBOX_POLL_INTERVAL=30s
APP_MAIL_OUTBOX_MAX_ATTEMPTS=8
APP_MAIL_OUTBOX_BATCH_SIZE=20
SPRING_PROFILES_ACTIVE=dev
